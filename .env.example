# Copy to .env and adjust. All values are optional; these are the defaults.

# Every route becomes <name>.DOMAIN, and the UI lives at proxy.DOMAIN
DOMAIN=home.arpa

# Port Caddy listens on for proxied traffic
PROXY_PORT=80

# Port of the management UI (also reachable at http://proxy.DOMAIN)
UI_PORT=8099

# IP/hostname pre-filled in the "Target" field when adding a route,
# e.g. the server most of your services run on
DEFAULT_TARGET=

# Container timezone (affects log timestamps)
TZ=UTC
